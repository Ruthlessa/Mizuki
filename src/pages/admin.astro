---
import { PageHeader } from "@components/features/page-header";

import MainGridLayout from "../layouts/MainGridLayout.astro";

// 页面标题
const title = "网站管理";
---

<MainGridLayout title={title}>
	<!-- 引入右侧边栏布局管理器 -->
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>

	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<PageHeader title={title} />

			<!-- 管理面板内容 -->
			<div class="mt-6 space-y-6">
				<!-- 网站概览卡片 -->
				<div class="card-base p-6">
					<h3 class="text-xl font-semibold mb-4 flex items-center">
						<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
							<path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"></path>
						</svg>
						网站概览
					</h3>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
						<div class="bg-gradient-to-r from-blue-500 to-blue-600 text-white p-4 rounded-lg">
							<div class="text-2xl font-bold">42</div>
							<div class="text-sm opacity-90">总文章数</div>
						</div>
						<div class="bg-gradient-to-r from-green-500 to-green-600 text-white p-4 rounded-lg">
							<div class="text-2xl font-bold">1,234</div>
							<div class="text-sm opacity-90">总访问量</div>
						</div>
						<div class="bg-gradient-to-r from-purple-500 to-purple-600 text-white p-4 rounded-lg">
							<div class="text-2xl font-bold">89</div>
							<div class="text-sm opacity-90">评论数</div>
						</div>
					</div>
				</div>

				<!-- 内容管理卡片 -->
				<div class="card-base p-6">
					<h3 class="text-xl font-semibold mb-4 flex items-center">
						<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2H4zm0 2h12v8H4V6z" clip-rule="evenodd"></path>
						</svg>
						内容管理
					</h3>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<a href="/admin/posts" class="block p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
							<div class="flex items-center">
								<svg class="w-8 h-8 text-blue-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2H4zm0 2h12v8H4V6z" clip-rule="evenodd"></path>
								</svg>
								<div>
									<h4 class="font-semibold">文章管理</h4>
									<p class="text-sm text-gray-600 dark:text-gray-400">管理博客文章和页面内容</p>
								</div>
							</div>
						</a>

						<a href="/admin/comments" class="block p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
							<div class="flex items-center">
								<svg class="w-8 h-8 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"></path>
								</svg>
								<div>
									<h4 class="font-semibold">评论管理</h4>
									<p class="text-sm text-gray-600 dark:text-gray-400">审核和管理用户评论</p>
								</div>
							</div>
						</a>

						<a href="/admin/media" class="block p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
							<div class="flex items-center">
								<svg class="w-8 h-8 text-purple-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
								</svg>
								<div>
									<h4 class="font-semibold">媒体库</h4>
									<p class="text-sm text-gray-600 dark:text-gray-400">管理图片、视频等媒体文件</p>
								</div>
							</div>
						</a>

						<a href="/admin/analytics" class="block p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
							<div class="flex items-center">
								<svg class="w-8 h-8 text-orange-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
									<path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"></path>
								</svg>
								<div>
									<h4 class="font-semibold">数据统计</h4>
									<p class="text-sm text-gray-600 dark:text-gray-400">查看网站访问和性能数据</p>
								</div>
							</div>
						</a>
					</div>
				</div>

				<!-- 系统设置卡片 -->
				<div class="card-base p-6">
					<h3 class="text-xl font-semibold mb-4 flex items-center">
						<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c1.56.379 2.978-1.56 2.978-2.978a1.533 1.533 0 01.947-2.287c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01-2.287-.947c-.379-1.56-2.6-1.56-2.978 0a1.533 1.533 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"></path>
						</svg>
						系统设置
					</h3>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<a href="/admin/settings/general" class="block p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
							<div class="flex items-center">
								<svg class="w-8 h-8 text-indigo-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c1.56.379 2.978-1.56 2.978-2.978a1.533 1.533 0 01.947-2.287c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01-2.287-.947c-.379-1.56-2.6-1.56-2.978 0a1.533 1.533 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"></path>
								</svg>
								<div>
									<h4 class="font-semibold">通用设置</h4>
									<p class="text-sm text-gray-600 dark:text-gray-400">网站基本信息和外观设置</p>
								</div>
							</div>
						</a>

						<a href="/admin/settings/security" class="block p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
							<div class="flex items-center">
								<svg class="w-8 h-8 text-red-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
								</svg>
								<div>
									<h4 class="font-semibold">安全设置</h4>
									<p class="text-sm text-gray-600 dark:text-gray-400">密码、权限和安全配置</p>
								</div>
							</div>
						</a>
					</div>
				</div>

				<!-- 快速操作卡片 -->
				<div class="card-base p-6">
					<h3 class="text-xl font-semibold mb-4 flex items-center">
						<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.293l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd"></path>
						</svg>
						快速操作
					</h3>
					<div class="flex flex-wrap gap-3">
						<button class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg transition-colors">
							<svg class="w-4 h-4 inline mr-2" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd"></path>
							</svg>
							刷新缓存
						</button>
						<button class="px-4 py-2 bg-green-500 hover:bg-green-600 text-white rounded-lg transition-colors">
							<svg class="w-4 h-4 inline mr-2" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path>
							</svg>
							导出数据
						</button>
						<button class="px-4 py-2 bg-yellow-500 hover:bg-yellow-600 text-white rounded-lg transition-colors">
							<svg class="w-4 h-4 inline mr-2" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
							</svg>
							系统诊断
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</MainGridLayout>