---
import { PageHeader } from "@components/features/page-header";

import MainGridLayout from "../../layouts/MainGridLayout.astro";

const title = "文章管理";
---

<MainGridLayout title={title}>
	<script>
		import("../../scripts/right-sidebar-layout.js");
	</script>

	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
			<PageHeader title={title} />

			<div class="mt-6 space-y-6">
				<div class="flex justify-between items-center">
					<div class="flex gap-4">
						<button
							class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg transition-colors"
						>
							<svg
								class="w-4 h-4 inline mr-2"
								fill="currentColor"
								viewBox="0 0 20 20"
							>
								<path
									fill-rule="evenodd"
									d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
									clip-rule="evenodd"></path>
							</svg>
							新建文章
						</button>
						<select
							class="px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800"
						>
							<option>全部状态</option>
							<option>已发布</option>
							<option>草稿</option>
							<option>待审核</option>
						</select>
					</div>
					<input
						type="text"
						placeholder="搜索文章..."
						class="px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 w-64"
					/>
				</div>

				<div class="card-base overflow-x-auto">
					<table class="w-full">
						<thead>
							<tr
								class="border-b border-gray-200 dark:border-gray-700"
							>
								<th class="text-left py-3 px-4 font-medium"
									>标题</th
								>
								<th class="text-left py-3 px-4 font-medium"
									>分类</th
								>
								<th class="text-left py-3 px-4 font-medium"
									>状态</th
								>
								<th class="text-left py-3 px-4 font-medium"
									>日期</th
								>
								<th class="text-left py-3 px-4 font-medium"
									>操作</th
								>
							</tr>
						</thead>
						<tbody>
							<tr
								class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800"
							>
								<td class="py-3 px-4"
									>如何使用 Astro 构建现代化博客</td
								>
								<td class="py-3 px-4">教程</td>
								<td class="py-3 px-4">
									<span
										class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-sm"
										>已发布</span
									>
								</td>
								<td class="py-3 px-4">2026-05-10</td>
								<td class="py-3 px-4">
									<div class="flex gap-2">
										<button
											class="text-blue-500 hover:text-blue-600"
											>编辑</button
										>
										<button
											class="text-red-500 hover:text-red-600"
											>删除</button
										>
									</div>
								</td>
							</tr>
							<tr
								class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800"
							>
								<td class="py-3 px-4"
									>React 18 新特性深度解析</td
								>
								<td class="py-3 px-4">前端</td>
								<td class="py-3 px-4">
									<span
										class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded-full text-sm"
										>草稿</span
									>
								</td>
								<td class="py-3 px-4">2026-05-12</td>
								<td class="py-3 px-4">
									<div class="flex gap-2">
										<button
											class="text-blue-500 hover:text-blue-600"
											>编辑</button
										>
										<button
											class="text-red-500 hover:text-red-600"
											>删除</button
										>
									</div>
								</td>
							</tr>
							<tr
								class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800"
							>
								<td class="py-3 px-4"
									>TypeScript 高级类型技巧</td
								>
								<td class="py-3 px-4">前端</td>
								<td class="py-3 px-4">
									<span
										class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-sm"
										>已发布</span
									>
								</td>
								<td class="py-3 px-4">2026-05-11</td>
								<td class="py-3 px-4">
									<div class="flex gap-2">
										<button
											class="text-blue-500 hover:text-blue-600"
											>编辑</button
										>
										<button
											class="text-red-500 hover:text-red-600"
											>删除</button
										>
									</div>
								</td>
							</tr>
						</tbody>
					</table>
				</div>

				<div class="flex justify-center mt-6">
					<div class="flex gap-2">
						<button
							class="px-3 py-1 border border-gray-300 dark:border-gray-700 rounded hover:bg-gray-100 dark:hover:bg-gray-700"
							>上一页</button
						>
						<button class="px-3 py-1 bg-blue-500 text-white rounded"
							>1</button
						>
						<button
							class="px-3 py-1 border border-gray-300 dark:border-gray-700 rounded hover:bg-gray-100 dark:hover:bg-gray-700"
							>2</button
						>
						<button
							class="px-3 py-1 border border-gray-300 dark:border-gray-700 rounded hover:bg-gray-100 dark:hover:bg-gray-700"
							>3</button
						>
						<button
							class="px-3 py-1 border border-gray-300 dark:border-gray-700 rounded hover:bg-gray-100 dark:hover:bg-gray-700"
							>下一页</button
						>
					</div>
				</div>
			</div>
		</div>
	</div>
</MainGridLayout>
