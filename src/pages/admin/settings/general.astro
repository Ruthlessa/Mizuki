---
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "../../../layouts/MainGridLayout.astro";

const title = "通用设置";
---

<MainGridLayout title={title}>
  <script>
    import("../../../scripts/right-sidebar-layout.js");
  </script>

  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <PageHeader title={title} />

      <div class="mt-6 space-y-8">
        <div class="card-base p-6">
          <h3 class="text-lg font-semibold mb-6">基本信息</h3>
          
          <div class="space-y-4 max-w-2xl">
            <div>
              <label class="block text-sm font-medium mb-2">网站标题</label>
              <input type="text" value="我的个人博客" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800" />
            </div>
            
            <div>
              <label class="block text-sm font-medium mb-2">网站副标题</label>
              <input type="text" value="分享技术，记录生活" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800" />
            </div>
            
            <div>
              <label class="block text-sm font-medium mb-2">网站描述</label>
              <textarea rows="3" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 resize-none">这是一个使用 Astro 构建的个人博客，记录我的学习历程和技术分享。</textarea>
            </div>
            
            <div>
              <label class="block text-sm font-medium mb-2">关键词</label>
              <input type="text" value="博客,技术,前端,全栈" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800" placeholder="用逗号分隔" />
            </div>
          </div>
        </div>

        <div class="card-base p-6">
          <h3 class="text-lg font-semibold mb-6">外观设置</h3>
          
          <div class="space-y-4 max-w-2xl">
            <div>
              <label class="block text-sm font-medium mb-2">主题模式</label>
              <select class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800">
                <option>跟随系统</option>
                <option>浅色模式</option>
                <option>深色模式</option>
              </select>
            </div>
            
            <div>
              <label class="block text-sm font-medium mb-2">主题色</label>
              <div class="flex gap-3">
                <button class="w-8 h-8 rounded-full bg-blue-500 ring-2 ring-offset-2 ring-blue-500"></button>
                <button class="w-8 h-8 rounded-full bg-green-500"></button>
                <button class="w-8 h-8 rounded-full bg-purple-500"></button>
                <button class="w-8 h-8 rounded-full bg-red-500"></button>
                <button class="w-8 h-8 rounded-full bg-orange-500"></button>
                <button class="w-8 h-8 rounded-full bg-pink-500"></button>
              </div>
            </div>
            
            <div>
              <label class="block text-sm font-medium mb-2">每页文章数</label>
              <input type="number" value="10" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800" />
            </div>
          </div>
        </div>

        <div class="card-base p-6">
          <h3 class="text-lg font-semibold mb-6">社交链接</h3>
          
          <div class="space-y-4 max-w-2xl">
            <div>
              <label class="block text-sm font-medium mb-2">GitHub</label>
              <div class="flex gap-2">
                <span class="inline-flex items-center px-3 py-2 border border-r-0 border-gray-300 dark:border-gray-700 rounded-l-lg bg-gray-50 dark:bg-gray-700 text-gray-500">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.477 0 10c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0110 4.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C17.138 18.163 20 14.418 20 10c0-5.523-4.477-10-10-10z" clip-rule="evenodd"></path>
                  </svg>
                </span>
                <input type="text" value="https://github.com/yourusername" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-r-lg bg-white dark:bg-gray-800" />
              </div>
            </div>
            
            <div>
              <label class="block text-sm font-medium mb-2">Twitter</label>
              <div class="flex gap-2">
                <span class="inline-flex items-center px-3 py-2 border border-r-0 border-gray-300 dark:border-gray-700 rounded-l-lg bg-gray-50 dark:bg-gray-700 text-gray-500">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M6.29 18.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0020 3.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.25c0 .778.099 1.536.284 2.25A11.616 11.616 0 006.29 18.25z"></path>
                  </svg>
                </span>
                <input type="text" placeholder="https://twitter.com/yourusername" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-r-lg bg-white dark:bg-gray-800" />
              </div>
            </div>
            
            <div>
              <label class="block text-sm font-medium mb-2">Email</label>
              <div class="flex gap-2">
                <span class="inline-flex items-center px-3 py-2 border border-r-0 border-gray-300 dark:border-gray-700 rounded-l-lg bg-gray-50 dark:bg-gray-700 text-gray-500">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                    <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                  </svg>
                </span>
                <input type="email" value="hello@example.com" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-r-lg bg-white dark:bg-gray-800" />
              </div>
            </div>
          </div>
        </div>

        <div class="flex justify-end gap-3">
          <button class="px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">重置</button>
          <button class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg transition-colors">保存更改</button>
        </div>
      </div>
    </div>
  </div>
</MainGridLayout>
