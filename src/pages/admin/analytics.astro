---
import { PageHeader } from "@components/features/page-header";

import MainGridLayout from "../../layouts/MainGridLayout.astro";

const title = "数据统计";
---

<MainGridLayout title={title}>
	<script>
		import("../../scripts/right-sidebar-layout.js");
	</script>

	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<PageHeader title={title} />

			<div class="mt-6 space-y-6">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
					<div class="card-base p-6">
						<div class="flex items-center justify-between">
							<div>
								<div class="text-sm text-gray-500">总访问量</div>
								<div class="text-3xl font-bold mt-2">12,345</div>
								<div class="text-sm text-green-500 mt-1">+12.5%</div>
							</div>
							<div class="w-12 h-12 rounded-full bg-blue-100 dark:bg-blue-900 flex items-center justify-center">
								<svg
									class="w-6 h-6 text-blue-500"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
									></path>
								</svg>
							</div>
						</div>
					</div>
					<div class="card-base p-6">
						<div class="flex items-center justify-between">
							<div>
								<div class="text-sm text-gray-500">独立访客</div>
								<div class="text-3xl font-bold mt-2">2,345</div>
								<div class="text-sm text-green-500 mt-1">+8.2%</div>
							</div>
							<div class="w-12 h-12 rounded-full bg-green-100 dark:bg-green-900 flex items-center justify-center">
								<svg
									class="w-6 h-6 text-green-500"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
									></path>
								</svg>
							</div>
						</div>
					</div>
					<div class="card-base p-6">
						<div class="flex items-center justify-between">
							<div>
								<div class="text-sm text-gray-500">平均停留</div>
								<div class="text-3xl font-bold mt-2">3:45</div>
								<div class="text-sm text-red-500 mt-1">-2.1%</div>
							</div>
							<div class="w-12 h-12 rounded-full bg-purple-100 dark:bg-purple-900 flex items-center justify-center">
								<svg
									class="w-6 h-6 text-purple-500"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
									></path>
								</svg>
							</div>
						</div>
					</div>
					<div class="card-base p-6">
						<div class="flex items-center justify-between">
							<div>
								<div class="text-sm text-gray-500">跳出率</div>
								<div class="text-3xl font-bold mt-2">35.2%</div>
								<div class="text-sm text-green-500 mt-1">-5.4%</div>
							</div>
							<div class="w-12 h-12 rounded-full bg-orange-100 dark:bg-orange-900 flex items-center justify-center">
								<svg
									class="w-6 h-6 text-orange-500"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
									></path>
								</svg>
							</div>
						</div>
					</div>
				</div>

				<div class="card-base p-6">
					<h3 class="text-lg font-semibold mb-4">访问趋势</h3>
					<div class="h-80 bg-gray-50 dark:bg-gray-800 rounded-lg flex items-center justify-center">
						<div class="text-center text-gray-500">
							<svg
								class="w-16 h-16 mx-auto mb-2"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
								></path>
							</svg>
							<p>图表组件</p>
						</div>
					</div>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
					<div class="card-base p-6">
						<h3 class="text-lg font-semibold mb-4">热门页面</h3>
						<div class="space-y-3">
							<div class="flex items-center justify-between p-3 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg">
								<div class="flex items-center gap-3">
									<div class="w-8 h-8 rounded bg-blue-100 dark:bg-blue-900 flex items-center justify-center text-blue-600 dark:text-blue-400 text-sm font-bold">1</div>
									<div>
										<div class="font-medium">/</div>
										<div class="text-sm text-gray-500">首页</div>
									</div>
								</div>
								<div class="text-sm text-gray-500">5,678 次</div>
							</div>
							<div class="flex items-center justify-between p-3 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg">
								<div class="flex items-center gap-3">
									<div class="w-8 h-8 rounded bg-green-100 dark:bg-green-900 flex items-center justify-center text-green-600 dark:text-green-400 text-sm font-bold">2</div>
									<div>
										<div class="font-medium">/posts/guide</div>
										<div class="text-sm text-gray-500">入门指南</div>
									</div>
								</div>
								<div class="text-sm text-gray-500">3,456 次</div>
							</div>
							<div class="flex items-center justify-between p-3 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg">
								<div class="flex items-center gap-3">
									<div class="w-8 h-8 rounded bg-purple-100 dark:bg-purple-900 flex items-center justify-center text-purple-600 dark:text-purple-400 text-sm font-bold">3</div>
									<div>
										<div class="font-medium">/about</div>
										<div class="text-sm text-gray-500">关于</div>
									</div>
								</div>
								<div class="text-sm text-gray-500">2,345 次</div>
							</div>
						</div>
					</div>
					<div class="card-base p-6">
						<h3 class="text-lg font-semibold mb-4">设备统计</h3>
						<div class="space-y-3">
							<div class="flex items-center justify-between p-3 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg">
								<div class="flex items-center gap-3">
									<svg
										class="w-6 h-6 text-gray-600"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
										></path>
									</svg>
									<div>桌面端</div>
								</div>
								<div class="flex items-center gap-3">
									<div class="w-48 h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
										<div class="h-full bg-blue-500" style="width: 65%"></div>
									</div>
									<div class="text-sm text-gray-500">65%</div>
								</div>
							</div>
							<div class="flex items-center justify-between p-3 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg">
								<div class="flex items-center gap-3">
									<svg
										class="w-6 h-6 text-gray-600"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
										></path>
									</svg>
									<div>移动端</div>
								</div>
								<div class="flex items-center gap-3">
									<div class="w-48 h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
										<div class="h-full bg-green-500" style="width: 30%"></div>
									</div>
									<div class="text-sm text-gray-500">30%</div>
								</div>
							</div>
							<div class="flex items-center justify-between p-3 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg">
								<div class="flex items-center gap-3">
									<svg
										class="w-6 h-6 text-gray-600"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
										></path>
									</svg>
									<div>平板</div>
								</div>
								<div class="flex items-center gap-3">
									<div class="w-48 h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
										<div class="h-full bg-purple-500" style="width: 5%"></div>
									</div>
									<div class="text-sm text-gray-500">5%</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</MainGridLayout>
