---
// DigitalPlat 侧栏小部件：把 DigitalPlat 按钮包装成统一布局的 Widget 卡片。
// 被 widgetManager 渲染到侧栏对应位置，样式类由外部透传。
import DigitalPlatButton from "@/components/control/DigitalPlatButton.astro";

import WidgetLayout from "../common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;
---

<WidgetLayout
	name="DigitalPlat"
	id="digitalplat"
	class={className}
	style={style}
>
	<div class="flex justify-center">
		<DigitalPlatButton />
	</div>
</WidgetLayout>
