---
// 右侧栏入口：仅桌面端显示，复用 SidebarColumn 渲染文章目录（TOC）。
// 实际粘性定位、滚动高亮等逻辑都在 SidebarColumn 内部实现。
import type { MarkdownHeading } from "astro";

import SidebarColumn from "@/components/layout/SidebarColumn.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const { class: className, headings } = Astro.props;
---

<SidebarColumn
	side="right"
	containerId="right-sidebar"
	stickyId="right-sidebar-sticky"
	rootClass={`${className ?? ""} w-full`}
	headings={headings}
	showMobile={false}
	showTablet={false}
	showDesktop={true}
/>
