---
// 列表分隔线组件：输出一条使用分隔线主题色的横线，可选虚线/实线/点线样式。
// 用于卡片列表间的视觉区隔，无交互逻辑。
type BorderStyle = "dashed" | "solid" | "dotted";

interface Props {
	style?: BorderStyle;
	class?: string;
}

const { style = "dashed", class: className } = Astro.props;
---

<div
	class:list={["border-b border-(--line-divider)", className]}
	style={`border-style: ${style};`}
>
</div>
