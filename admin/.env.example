# 前端开发环境配置
VITE_APP_TITLE=Mizuki Admin
VITE_API_BASE_URL=/api

# 后端环境配置
NODE_ENV=development
PORT=3000
# ⚠️ 安全要求：JWT_SECRET 必须 >= 32 字符的强随机字符串，
# 禁止使用示例值 "mizuki-admin-secret-key-2024" 等弱默认值。
# 本地开发建议使用以下命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 是否开启注册功能（默认关闭，防止未授权批量注册）。
# 确需开放注册时设为 true，创建完管理员账户后建议改回 false。
REGISTRATION_ENABLED=false

# 允许的前端 Origin 列表，多个用逗号分隔（CORS 白名单）
# FRONTEND_URL=http://localhost:3001,http://localhost:5173

# 数据库配置
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mizuki_admin
